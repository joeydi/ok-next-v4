{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!design_handoff_okayplus_site", "!docs", "!src/app/fluid.css", "!src/data/media.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "suspicious": { "noArrayIndexKey": "off", "noAssignInExpressions": "off", "noConfusingVoidType": "off" },
      "nursery": { "useReactCompiler": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["src/components/illustrations/gl/**", "src/components/network/**"],
      "linter": { "rules": { "correctness": { "useHookAtTopLevel": "off" } } }
    },
    {
      "includes": [
        "src/lib/og.tsx",
        "src/app/**/apple-icon.tsx",
        "src/app/**/icon.tsx",
        "src/app/**/opengraph-image.tsx"
      ],
      "linter": { "rules": { "performance": { "noImgElement": "off" } } }
    },
    {
      "includes": ["src/app/icon.svg"],
      "linter": { "rules": { "a11y": { "noSvgWithoutTitle": "off" } } }
    }
  ]
}
